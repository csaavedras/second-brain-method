#!/bin/bash
# sbm — the Second Brain Method CLI. macOS only, bash 3.2 compatible.
#
# Usage:
#   sbm install [--lang en|es] [--vault PATH] [--yes]
#   sbm update  [--lang en|es] [--no-pull] [--take-new]
#   sbm status
#
# install: fresh setup, or safe adoption of an existing hand-made ~/.claude
#          (nothing is clobbered — conflicts are written as <file>.new).
# update:  pulls the configured repo (unless --no-pull) and re-applies,
#          same never-clobber guarantee; --take-new resolves conflicts by
#          backing up the old content and taking the new rendered one.
# status:  read-only report: installed version vs this repo's VERSION,
#          any pending .new files, any file edited since the last apply.
#
# See lib/apply.sh for the per-file decision algorithm this drives.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="$SCRIPT_DIR/engine"
CLAUDE_DIR="${CLAUDE_HOME:-$HOME/.claude}"

# shellcheck source=lib/render.sh
source "$SCRIPT_DIR/lib/render.sh"
# shellcheck source=lib/manifest.sh
source "$SCRIPT_DIR/lib/manifest.sh"
# shellcheck source=lib/claude-md-block.sh
source "$SCRIPT_DIR/lib/claude-md-block.sh"
# shellcheck source=lib/backup.sh
source "$SCRIPT_DIR/lib/backup.sh"
# shellcheck source=lib/config.sh
source "$SCRIPT_DIR/lib/config.sh"
# shellcheck source=lib/settings-merge.sh
source "$SCRIPT_DIR/lib/settings-merge.sh"
# shellcheck source=lib/apply.sh
source "$SCRIPT_DIR/lib/apply.sh"

# --- messages ----------------------------------------------------------
# Bootstrap in English: the subcommand's own --lang selection happens
# later, once args are parsed — these pre-flight checks must be able to
# fail before any language state exists. cmd_install/cmd_update reassign
# MESSAGES_ENV once the language is resolved, so everything printed after
# that point (including summaries/next-steps) follows the resolved lang.
MESSAGES_ENV="$ENGINE/i18n/en/messages.env"

# msg <KEY> [printf-args...] — looks up KEY in $MESSAGES_ENV (same
# KEY=value convention documented in engine/i18n/en/messages.env's header)
# and prints it with a trailing newline, treating the value itself as a
# printf format string (so %s / %% and any embedded \n in the value work
# exactly like they do once render_file has spliced a MSG_* value into an
# installed script). This is a plain key lookup, not render_file's
# @@VAULT@@ substitution — sbm itself is never installed/copied anywhere,
# it runs straight from the repo checkout.
msg() {
  local key="$1"; shift
  local line val
  line="$(grep -m1 -- "^${key}=" "$MESSAGES_ENV" 2>/dev/null || true)"
  if [ -z "$line" ]; then
    printf 'sbm: missing message key %s in %s\n' "$key" "$MESSAGES_ENV" >&2
    exit 1
  fi
  val="${line#*=}"
  # shellcheck disable=SC2059
  printf -- "$val\n" "$@"
}

# --- dependency / environment checks -------------------------------------
[ "$(uname)" = "Darwin" ] || { msg MSG_SBM_NOT_DARWIN >&2; exit 1; }
[ -d "$ENGINE" ] || { msg MSG_SBM_NO_ENGINE >&2; exit 1; }
command -v git    >/dev/null || { msg MSG_SBM_MISSING_DEP "git"    "brew install git"  >&2; exit 1; }
command -v jq     >/dev/null || { msg MSG_SBM_MISSING_DEP "jq"     "brew install jq"   >&2; exit 1; }
command -v perl   >/dev/null || { msg MSG_SBM_MISSING_DEP "perl"   "brew install perl" >&2; exit 1; }
command -v shasum >/dev/null || { msg MSG_SBM_MISSING_DEP "shasum" "brew install perl" >&2; exit 1; }
command -v claude >/dev/null || msg MSG_SBM_MISSING_CLAUDE_CLI

VERSION="$(cat "$SCRIPT_DIR/VERSION")"

# --- args ------------------------------------------------------------------
SUBCOMMAND=""
if [ $# -gt 0 ]; then
  SUBCOMMAND="$1"
  shift
fi

LANG_OPT=""
VAULT_OPT=""
YES=0
NO_PULL=0
TAKE_NEW=0

while [ $# -gt 0 ]; do
  case "$1" in
    --lang)      LANG_OPT="${2:-}"; shift 2 ;;
    --lang=*)    LANG_OPT="${1#--lang=}"; shift ;;
    --vault)     VAULT_OPT="${2:-}"; shift 2 ;;
    --vault=*)   VAULT_OPT="${1#--vault=}"; shift ;;
    --yes)       YES=1; shift ;;
    --no-pull)   NO_PULL=1; shift ;;
    --take-new)  TAKE_NEW=1; shift ;;
    *) msg MSG_SBM_UNKNOWN_FLAG "$1" >&2; exit 1 ;;
  esac
done

# resolve_lang_messages <requested> — sets LANG_RESOLVED and (re)points the
# global MESSAGES_ENV at engine/i18n/<requested>/messages.env; exits 1 with
# a clear message (naming the available languages) if that file doesn't
# exist, instead of letting render_file/jq/perl fail with a raw
# file-not-found further down the line.
resolve_lang_messages() {
  local requested="$1" path avail d
  path="$ENGINE/i18n/$requested/messages.env"
  if [ ! -f "$path" ]; then
    avail=""
    for d in "$ENGINE"/i18n/*/; do
      [ -d "$d" ] || continue
      avail="$avail $(basename "$d")"
    done
    msg MSG_SBM_LANG_UNAVAILABLE "$requested" "${avail# }" >&2
    exit 1
  fi
  LANG_RESOLVED="$requested"
  MESSAGES_ENV="$path"
}

# --- vault scaffold (install-time only; NOT part of apply()) --------------
# Verbatim port of install.sh step 5 (folders + .gitignore + home.md) plus
# step 7 (git init), reused as-is per the brief. home.md's frontmatter is
# generated here (it needs today's date); its body comes from the
# per-language vault/home.md overlay via _apply_src (F4a) — not tracked by
# the manifest, scaffolded once, only into a missing/empty vault.
scaffold_vault() {
  local vault="$1" lang="$2"
  if [ ! -d "$vault" ] || [ -z "$(ls -A "$vault" 2>/dev/null)" ]; then
    mkdir -p "$vault"/{projects,learning/til,learning/concept,patterns,briefs,00-index}

    cat > "$vault/.gitignore" <<'EOF'
.DS_Store
.trash/
.obsidian/workspace*
.obsidian/cache
EOF

    if [ ! -f "$vault/00-index/home.md" ]; then
      {
        cat <<EOF
---
type: moc
date: $(date +%Y-%m-%d)
tags: [meta]
---
EOF
        cat "$(_apply_src "$ENGINE" "$lang" "vault/home.md")"
      } > "$vault/00-index/home.md"
    fi
  fi

  [ -d "$vault/.git" ] || git -C "$vault" init -q
}

# --- report summary helper (used by both install and update) --------------
print_report_summary() {
  local report_file="$1"
  local added updated conflict taken deleted orphaned

  added="$(grep -c $'^ADDED\t'    "$report_file" || true)"
  updated="$(grep -c $'^UPDATED\t'  "$report_file" || true)"
  conflict="$(grep -c $'^CONFLICT\t' "$report_file" || true)"
  taken="$(grep -c $'^TAKEN\t'    "$report_file" || true)"
  deleted="$(grep -c $'^DELETED\t'  "$report_file" || true)"
  orphaned="$(grep -c $'^ORPHANED\t' "$report_file" || true)"

  msg MSG_SBM_SUMMARY_COUNTS "$added" "$updated" "$conflict" "$taken" "$deleted" "$orphaned"

  if [ "$conflict" -gt 0 ] || [ "$taken" -gt 0 ]; then
    msg MSG_SBM_CONFLICT_LIST_HDR
    grep -E $'^(CONFLICT|TAKEN)\t' "$report_file" | while IFS=$'\t' read -r status dest extra; do
      msg MSG_SBM_CONFLICT_LINE "$status" "$dest" "$extra"
    done
  fi

  if [ "$deleted" -gt 0 ] || [ "$orphaned" -gt 0 ]; then
    msg MSG_SBM_REMOVED_LIST_HDR
    grep -E $'^(DELETED|ORPHANED)\t' "$report_file" | while IFS=$'\t' read -r status dest _; do
      msg MSG_SBM_REMOVED_LINE "$status" "$dest"
    done
  fi
}

# --- subcommands -----------------------------------------------------------

cmd_install() {
  if config_exists; then
    msg MSG_SBM_ALREADY_INSTALLED >&2
    exit 1
  fi

  local lang vault
  if [ -n "$LANG_OPT" ]; then
    lang="$LANG_OPT"
  elif [ "$YES" -eq 1 ]; then
    lang="en"
  else
    read -r -p "$(msg MSG_SBM_PROMPT_LANG)" lang || true
    lang="${lang:-en}"
  fi
  resolve_lang_messages "$lang"
  lang="$LANG_RESOLVED"

  if [ -n "$VAULT_OPT" ]; then
    vault="${VAULT_OPT/#\~/$HOME}"
  elif [ "$YES" -eq 1 ]; then
    vault="$HOME/second-brain"
  else
    read -r -p "$(msg MSG_SBM_PROMPT_VAULT)" vault || true
    vault="${vault:-$HOME/second-brain}"
    vault="${vault/#\~/$HOME}"
  fi

  msg MSG_SBM_METHOD_HEADER "$CLAUDE_DIR"
  msg MSG_SBM_VAULT_HEADER "$vault"

  scaffold_vault "$vault" "$lang"

  local report_file
  report_file="$(mktemp)"
  if ! apply "$lang" "$CLAUDE_DIR" "$vault" > "$report_file"; then
    rm -f "$report_file"
    msg MSG_SBM_APPLY_FAILED >&2
    exit 1
  fi

  config_write "$VERSION" "$lang" "$vault" "$SCRIPT_DIR" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  print_report_summary "$report_file"
  rm -f "$report_file"

  msg MSG_SBM_INSTALL_DONE "$vault"
  msg MSG_SBM_NEXT_STEPS "$vault"
}

cmd_update() {
  if ! config_exists; then
    msg MSG_SBM_NOT_INSTALLED >&2
    exit 1
  fi

  local repo old_version lang vault installed_at
  repo="$(config_get repo)"

  if [ "$NO_PULL" -ne 1 ]; then
    local dirty branch
    dirty="$(git -C "$repo" status --porcelain)"
    if [ -n "$dirty" ]; then
      msg MSG_SBM_REPO_DIRTY "$repo" >&2
      exit 1
    fi
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
    if [ "$branch" != "main" ]; then
      msg MSG_SBM_REPO_NOT_MAIN "$branch" >&2
      exit 1
    fi
    if ! git -C "$repo" pull --ff-only; then
      msg MSG_SBM_PULL_FAILED >&2
      exit 1
    fi
    # VERSION may have changed with the pull.
    VERSION="$(cat "$repo/VERSION")"
  fi

  old_version="$(config_get version)"

  if [ -n "$LANG_OPT" ]; then
    lang="$LANG_OPT"
  else
    lang="$(config_get lang)"
  fi
  resolve_lang_messages "$lang"
  lang="$LANG_RESOLVED"

  vault="$(config_get vault)"
  installed_at="$(config_get installed_at)"

  local report_file
  report_file="$(mktemp)"
  local rc=0
  if [ "$TAKE_NEW" -eq 1 ]; then
    apply "$lang" "$CLAUDE_DIR" "$vault" --take-new > "$report_file" || rc=$?
  else
    apply "$lang" "$CLAUDE_DIR" "$vault" > "$report_file" || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    rm -f "$report_file"
    msg MSG_SBM_APPLY_FAILED >&2
    exit 1
  fi

  # Preserves the ORIGINAL installed_at (means "first installed", not
  # "last updated") — config_write always takes the full row, so we must
  # pass it back through unchanged here.
  config_write "$VERSION" "$lang" "$vault" "$repo" "$installed_at"

  msg MSG_SBM_UPDATE_VERSION_LINE "$old_version" "$VERSION"
  print_report_summary "$report_file"
  rm -f "$report_file"

  msg MSG_SBM_UPDATE_DONE
}

cmd_status() {
  if ! config_exists; then
    msg MSG_SBM_NOT_INSTALLED >&2
    exit 1
  fi

  local inst_version inst_lang inst_vault
  inst_version="$(config_get version)"
  inst_lang="$(config_get lang)"
  inst_vault="$(config_get vault)"

  # Speak the installed language if this checkout has it; else stay English
  # (never fail status over a missing/renamed language).
  if [ -f "$ENGINE/i18n/$inst_lang/messages.env" ]; then
    MESSAGES_ENV="$ENGINE/i18n/$inst_lang/messages.env"
  fi

  msg MSG_SBM_STATUS_HEADER
  msg MSG_SBM_STATUS_VERSION_LINE "$inst_version" "$inst_lang" "$inst_vault"
  if [ "$inst_version" != "$VERSION" ]; then
    msg MSG_SBM_STATUS_VERSION_MISMATCH "$inst_version" "$VERSION"
  fi

  local new_files
  new_files="$(
    { find "$CLAUDE_DIR/commands" "$CLAUDE_DIR/agents" "$CLAUDE_DIR/hooks" "$inst_vault/method" \
        -name '*.new' 2>/dev/null || true
      if [ -f "$CLAUDE_DIR/CLAUDE.md.new" ]; then printf '%s\n' "$CLAUDE_DIR/CLAUDE.md.new"; fi
    } | sort
  )"

  local mpath key msha csha edited_list
  mpath="$(manifest_path)"
  edited_list=""
  if [ -f "$mpath" ]; then
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      [ -f "$key" ] || continue
      msha="$(manifest_get "$key")"
      csha="$(manifest_sha256 "$key")"
      if [ "$msha" != "$csha" ]; then
        if [ -z "$edited_list" ]; then
          edited_list="$key"
        else
          edited_list="$edited_list
$key"
        fi
      fi
    done < <(jq -r 'keys[]' "$mpath")
  fi

  if [ -z "$new_files" ] && [ -z "$edited_list" ]; then
    msg MSG_SBM_STATUS_CLEAN
  else
    if [ -n "$new_files" ]; then
      msg MSG_SBM_STATUS_NEW_FILES_HDR
      printf '%s\n' "$new_files" | while IFS= read -r f; do printf '     %s\n' "$f"; done
    fi
    if [ -n "$edited_list" ]; then
      msg MSG_SBM_STATUS_EDITED_FILES_HDR
      printf '%s\n' "$edited_list" | while IFS= read -r f; do printf '     %s\n' "$f"; done
    fi
  fi

  exit 0
}

case "$SUBCOMMAND" in
  install) cmd_install ;;
  update)  cmd_update ;;
  status)  cmd_status ;;
  ""|-h|--help) msg MSG_SBM_USAGE; exit 0 ;;
  *) msg MSG_SBM_UNKNOWN_SUBCOMMAND "$SUBCOMMAND" >&2; exit 1 ;;
esac
