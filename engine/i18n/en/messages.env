# messages.env — English strings for the method's bash scripts/hooks.
#
# Format:
#   - One `KEY=value` per line.
#   - Lines starting with `#` (after optional leading whitespace) and blank
#     lines are ignored.
#   - The value is everything after the FIRST `=` on the line: literal text,
#     no surrounding quotes, no shell/variable expansion.
#   - `%s` marks a runtime argument (filled by printf or by a script's own
#     jq `fmt` helper, in order of appearance). `%%` is a literal `%`.
#   - Keys are stable across languages (see engine/i18n/<lang>/messages.env):
#     don't rename a key without updating every script that references it.
#
# Naming: @@MSG_<SCRIPT>_<NAME>@@, uppercase [A-Z0-9_].
#   MSG_HEALTH_*   engine/method/scripts/brain-health.sh
#   MSG_METRICS_*  engine/method/scripts/brain-metrics.sh
#   MSG_COLLECT_*  engine/method/scripts/collect-metrics.sh
#   MSG_CLOSE_*    engine/method/scripts/check-close.sh (+ claude/hooks twin)
#   MSG_BRIEF_*    engine/method/scripts/check-brief.sh (+ claude/hooks twin)

# --- brain-health.sh ---------------------------------------------------
MSG_HEALTH_ERR_NO_VAULT=ERROR: vault does not exist: %s
MSG_HEALTH_HEADER=🧠 brain-health — %s
MSG_HEALTH_NOTES=   Notes: %s
MSG_HEALTH_NO_FM=   ✗ no frontmatter: %s
MSG_HEALTH_NO_TYPE=   ✗ no type: %s
MSG_HEALTH_NO_DATE=   ✗ no date: %s
MSG_HEALTH_BROKEN_LINK=   ✗ [[%s]] broken in: %s
MSG_HEALTH_ORPHAN=   ✗ orphan (no incoming links): %s
MSG_HEALTH_LONG_CONTEXT=   ✗ %s lines (archive, ~150 rule): %s
MSG_HEALTH_SECRET=   ⚠ possible secret in: %s (review by hand)
MSG_HEALTH_TITLE_FM=Frontmatter
MSG_HEALTH_TITLE_BROKEN=Broken wikilinks
MSG_HEALTH_TITLE_ORPHANS=Orphan notes
MSG_HEALTH_TITLE_LONG=Long CONTEXT.md
MSG_HEALTH_TITLE_SECRETS=Possible secrets
MSG_HEALTH_OK=✅ Healthy vault (%s notes)
MSG_HEALTH_ISSUES=❌ %s issue(s) — fix before trusting the brain

# --- brain-metrics.sh ----------------------------------------------------
MSG_METRICS_ERR_NO_VAULT=ERROR: vault does not exist: %s
MSG_METRICS_HEADER=🧠 brain-metrics — %s
MSG_METRICS_NO_METRICS_YET=   No metrics yet — close a task with /close to start recording.
MSG_METRICS_SUMMARY=   Projects: %s   Tasks: %s
MSG_METRICS_OVERALL_TITLE=── Overall ──────────────────────────────────────────
MSG_METRICS_PROJECT_TITLE=── Project: %s ───────────────────────────────────
MSG_METRICS_MALFORMED=⚠️  %s malformed line(s) skipped
MSG_METRICS_CLEAN=✅ Report complete — no malformed lines
MSG_METRICS_NO_TASKS=   (no tasks recorded yet)
MSG_METRICS_TASKS_LINE=   Tasks: %s
MSG_METRICS_BY_TYPE_HDR=By type:
MSG_METRICS_BY_TYPE_ITEM=     - %s: %s task(s), avg total %smin, avg tokens %s
MSG_METRICS_EST_HDR=Estimate vs actual:
MSG_METRICS_NO_EST=     (no estimates recorded)
MSG_METRICS_EST_ITEM=     - %s: %s → %smin
MSG_METRICS_TOKENS_HDR=Parent vs subagents tokens:
MSG_METRICS_TOKENS_PARENT=     - parent: %s (%s%%)
MSG_METRICS_TOKENS_SUBAGENTS=     - subagents: %s (%s%%)
MSG_METRICS_MONTH_HDR=Month over month:
MSG_METRICS_MONTH_ITEM=     - %s: %s task(s), %s tokens
MSG_METRICS_NA=n/a

# --- collect-metrics.sh --------------------------------------------------
MSG_COLLECT_USAGE=Usage: collect-metrics.sh <transcript.jsonl> [events.jsonl] [--task T] [--type T] [--estimate E]
MSG_COLLECT_ERR_NOT_FOUND=ERROR: transcript not found: %s
MSG_COLLECT_ERR_FAILED=ERROR: failed to compute metrics from transcript: %s

# --- check-close.sh -------------------------------------------------------
MSG_CLOSE_STOP_BLOCK=Method close rule: the vault's CONTEXT.md (%s) was not updated in this session. If there was project work, run the /close routine now (~/.claude/commands/close.md): verification, CONTEXT.md, brain, commit message. If the session was read-only and there is nothing to close, say so explicitly and stop.
MSG_CLOSE_PRECOMPACT_MSG=⚠️ Compacting with CONTEXT.md not updated (%s) — run /close to persist the state before detail is lost.
MSG_CLOSE_PRECOMPACT_CTX=The conversation is about to be compacted and the vault's CONTEXT.md (%s) was not updated in this session. Before continuing, persist the state per /close: tasks, decisions, exact starting point for the next session.

# --- check-brief.sh --------------------------------------------------------
MSG_BRIEF_BLOCK=Method brief rule: the subagent report must include a Verification line for each acceptance-criteria command, in EXACTLY this shape: `Verification: `<command>` -> <literal result>` (arrow may be "->" or "→"), plus a "Criteria evidence" section with one line per acceptance criterion. Run the brief's acceptance-criteria commands and re-emit the full report.

# --- sbm (the CLI: install/update/status) ---------------------------------
# A few of these values embed literal two-character `\n` sequences on
# purpose: sbm's msg() helper feeds the value straight into printf as (part
# of) its format string, so printf turns those into real newlines at
# render time — the same trick already used everywhere a message ends in
# a literal `\n` before printf's own trailing one, just applied more than
# once per value here for the multi-line summaries/next-steps text.
MSG_SBM_NOT_DARWIN=This tool is macOS only.
MSG_SBM_NO_ENGINE=can't find engine/ next to sbm. Did you clone the whole repo?
MSG_SBM_MISSING_DEP=%s is missing (install with: %s).
MSG_SBM_MISSING_CLAUDE_CLI=can't find the 'claude' CLI — install Claude Code before using the method.
MSG_SBM_LANG_UNAVAILABLE=--lang %s is not available yet. Available language(s): %s
MSG_SBM_UNKNOWN_SUBCOMMAND=unknown subcommand: %s (use install, update or status)
MSG_SBM_UNKNOWN_FLAG=unknown flag: %s
MSG_SBM_USAGE=Usage: sbm install [--lang en|es] [--vault PATH] [--yes]\n       sbm update  [--lang en|es] [--no-pull] [--take-new]\n       sbm status
MSG_SBM_ALREADY_INSTALLED=the method is already installed at this CLAUDE_HOME. Use ./sbm update instead.
MSG_SBM_NOT_INSTALLED=the method isn't installed at this CLAUDE_HOME yet. Run ./sbm install [--vault <path>] first (this also safely adopts an existing hand-made ~/.claude setup).
MSG_SBM_REPO_DIRTY=the configured repo (%s) has uncommitted changes — commit or stash them, or re-run with --no-pull.
MSG_SBM_REPO_NOT_MAIN=the configured repo is on branch '%s', not 'main' — switch to main, or re-run with --no-pull.
MSG_SBM_PULL_FAILED=git pull --ff-only failed on the configured repo — resolve it by hand, or re-run with --no-pull.
MSG_SBM_APPLY_FAILED=apply failed — see the error above. Nothing else was written.
MSG_SBM_METHOD_HEADER=▸ Method → %s
MSG_SBM_VAULT_HEADER=▸ Vault  → %s
MSG_SBM_PROMPT_LANG=Language [en]:
MSG_SBM_PROMPT_VAULT=Vault path [~/second-brain]:
MSG_SBM_SUMMARY_COUNTS=▸ added=%s updated=%s conflict=%s taken=%s deleted=%s orphaned=%s
MSG_SBM_CONFLICT_LIST_HDR=▸ Review these by hand (the old file was left untouched):
MSG_SBM_CONFLICT_LINE=   %s  %s -> %s
MSG_SBM_REMOVED_LIST_HDR=▸ No longer part of the method:
MSG_SBM_REMOVED_LINE=   %s  %s
MSG_SBM_INSTALL_DONE=✓ Method installed. The vault lives at %s
MSG_SBM_NEXT_STEPS=\nHOW TO START\n  1. (optional) Open %s in Obsidian → "Open folder as vault".\n  2. Keep the per-repo anchor out of your projects' git (global gitignore):\n       git config --global core.excludesFile ~/.gitignore_global\n       printf 'CLAUDE.local.md\\n.claude/settings.local.json\\n' >> ~/.gitignore_global\n  3. Go into any project and start:\n       cd <your-repo> && claude\n       /new-project <name>       # registers the project in the vault\n       /start                    # opens the session\n  4. Work the cycle: plan -> task -> /close  (and /learn when you learn something).\n  5. Check on things anytime with ./sbm status, and upgrade later with ./sbm update.
MSG_SBM_UPDATE_VERSION_LINE=▸ Method %s -> %s
MSG_SBM_UPDATE_DONE=✓ Update complete.
MSG_SBM_STATUS_HEADER=▸ Second Brain Method — status
MSG_SBM_STATUS_VERSION_LINE=   installed version=%s lang=%s vault=%s
MSG_SBM_STATUS_VERSION_MISMATCH=   ⚠ installed version (%s) differs from this repo's VERSION (%s) — run ./sbm update.
MSG_SBM_STATUS_NEW_FILES_HDR=   .new files pending review:
MSG_SBM_STATUS_EDITED_FILES_HDR=   edited since the last apply (no manifest match):
MSG_SBM_STATUS_CLEAN=   ok — no .new files, nothing edited since the last apply.
