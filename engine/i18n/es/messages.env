# messages.env — strings en español para los scripts/hooks bash del método.
#
# Formato:
#   - Una `KEY=value` por línea.
#   - Las líneas que empiezan con `#` (con espacio inicial opcional) y las
#     líneas en blanco se ignoran.
#   - El valor es todo lo que sigue al PRIMER `=` de la línea: texto
#     literal, sin comillas envolventes, sin expansión de shell/variables.
#   - `%s` marca un argumento en tiempo de ejecución (lo completa printf o
#     el helper `fmt` de jq de cada script, en orden de aparición). `%%`
#     es un `%` literal.
#   - Las keys son estables entre idiomas (ver engine/i18n/<lang>/messages.env):
#     no renombres una key sin actualizar cada script que la referencia.
#
# Nomenclatura: @@MSG_<SCRIPT>_<NAME>@@, mayúsculas [A-Z0-9_].
#   MSG_HEALTH_*   engine/method/scripts/brain-health.sh
#   MSG_METRICS_*  engine/method/scripts/brain-metrics.sh
#   MSG_COLLECT_*  engine/method/scripts/collect-metrics.sh
#   MSG_CLOSE_*    engine/method/scripts/check-close.sh (+ gemelo en claude/hooks)
#   MSG_BRIEF_*    engine/method/scripts/check-brief.sh (+ gemelo en claude/hooks)

# --- brain-health.sh ---------------------------------------------------
MSG_HEALTH_ERR_NO_VAULT=ERROR: el vault no existe: %s
MSG_HEALTH_HEADER=🧠 brain-health — %s
MSG_HEALTH_NOTES=   Notas: %s
MSG_HEALTH_NO_FM=   ✗ sin frontmatter: %s
MSG_HEALTH_NO_TYPE=   ✗ sin type: %s
MSG_HEALTH_NO_DATE=   ✗ sin date: %s
MSG_HEALTH_BROKEN_LINK=   ✗ [[%s]] roto en: %s
MSG_HEALTH_ORPHAN=   ✗ huérfana (sin links entrantes): %s
MSG_HEALTH_LONG_CONTEXT=   ✗ %s líneas (archivar, regla ~150): %s
MSG_HEALTH_SECRET=   ⚠ posible secreto en: %s (revisar a mano)
MSG_HEALTH_TITLE_FM=Frontmatter
MSG_HEALTH_TITLE_BROKEN=Wikilinks rotos
MSG_HEALTH_TITLE_ORPHANS=Notas huérfanas
MSG_HEALTH_TITLE_LONG=CONTEXT.md largo
MSG_HEALTH_TITLE_SECRETS=Posibles secretos
MSG_HEALTH_OK=✅ Vault saludable (%s notas)
MSG_HEALTH_ISSUES=❌ %s problema(s) — arreglar antes de confiar en el cerebro

# --- brain-metrics.sh ----------------------------------------------------
MSG_METRICS_ERR_NO_VAULT=ERROR: el vault no existe: %s
MSG_METRICS_HEADER=🧠 brain-metrics — %s
MSG_METRICS_NO_METRICS_YET=   Todavía no hay métricas — cerrá una tarea con /close para empezar a registrar.
MSG_METRICS_SUMMARY=   Proyectos: %s   Tareas: %s
MSG_METRICS_OVERALL_TITLE=── General ──────────────────────────────────────────
MSG_METRICS_PROJECT_TITLE=── Proyecto: %s ───────────────────────────────────
MSG_METRICS_MALFORMED=⚠️  %s línea(s) mal formada(s) omitida(s)
MSG_METRICS_CLEAN=✅ Reporte completo — sin líneas mal formadas
MSG_METRICS_NO_TASKS=   (todavía no hay tareas registradas)
MSG_METRICS_TASKS_LINE=   Tareas: %s
MSG_METRICS_BY_TYPE_HDR=Por tipo:
MSG_METRICS_BY_TYPE_ITEM=     - %s: %s tarea(s), promedio total %smin, promedio tokens %s
MSG_METRICS_EST_HDR=Estimado vs real:
MSG_METRICS_NO_EST=     (no hay estimaciones registradas)
MSG_METRICS_EST_ITEM=     - %s: %s → %smin
MSG_METRICS_TOKENS_HDR=Tokens parent vs subagentes:
MSG_METRICS_TOKENS_PARENT=     - parent: %s (%s%%)
MSG_METRICS_TOKENS_SUBAGENTS=     - subagentes: %s (%s%%)
MSG_METRICS_MONTH_HDR=Mes a mes:
MSG_METRICS_MONTH_ITEM=     - %s: %s tarea(s), %s tokens
MSG_METRICS_NA=n/a

# --- collect-metrics.sh --------------------------------------------------
MSG_COLLECT_USAGE=Uso: collect-metrics.sh <transcript.jsonl> [events.jsonl] [--task T] [--type T] [--estimate E]
MSG_COLLECT_ERR_NOT_FOUND=ERROR: no se encontró el transcript: %s
MSG_COLLECT_ERR_FAILED=ERROR: no se pudieron calcular las métricas del transcript: %s

# --- check-close.sh -------------------------------------------------------
MSG_CLOSE_STOP_BLOCK=Regla de cierre del método: el CONTEXT.md del vault (%s) no se actualizó en esta sesión. Si hubo trabajo de proyecto, corré ahora la rutina de /close (~/.claude/commands/close.md): verificación, CONTEXT.md, cerebro, commit message. Si la sesión fue de solo lectura y no hay nada que cerrar, decilo explícitamente y frená.
MSG_CLOSE_PRECOMPACT_MSG=⚠️ Compactando con el CONTEXT.md sin actualizar (%s) — corré /close para persistir el estado antes de perder el detalle.
MSG_CLOSE_PRECOMPACT_CTX=La conversación está por compactarse y el CONTEXT.md del vault (%s) no se actualizó en esta sesión. Antes de continuar, persistí el estado según /close: tareas, decisiones, punto exacto de partida para la próxima sesión.

# --- check-brief.sh --------------------------------------------------------
MSG_BRIEF_BLOCK=Regla de brief del método: el reporte del subagente tiene que incluir una línea Verification por cada comando de criterios de aceptación, con EXACTAMENTE esta forma: `Verification: `<comando>` -> <resultado literal>` (la flecha puede ser "->" o "→"), más una sección "Criteria evidence" con una línea por criterio de aceptación. Corré los comandos de criterios de aceptación del brief y re-emití el reporte completo.

# --- sbm (el CLI: install/update/status) ---------------------------------
# Algunos de estos valores incluyen a propósito secuencias literales de dos
# caracteres `\n`: el helper msg() de sbm pasa el valor directo a printf
# como (parte de) su format string, así que printf las convierte en saltos
# de línea reales al momento de renderizar — el mismo truco que ya se usa
# en todos lados donde un mensaje termina en un `\n` literal antes del
# propio salto final de printf, acá aplicado más de una vez por valor para
# el texto multilínea de resúmenes/próximos pasos.
MSG_SBM_NOT_DARWIN=Esta herramienta es solo para macOS.
MSG_SBM_NO_ENGINE=no se encuentra engine/ al lado de sbm. ¿Clonaste el repo completo?
MSG_SBM_MISSING_DEP=falta %s (instalalo con: %s).
MSG_SBM_MISSING_CLAUDE_CLI=no se encuentra el CLI 'claude' — instalá Claude Code antes de usar el método.
MSG_SBM_LANG_UNAVAILABLE=--lang %s todavía no está disponible. Idioma(s) disponible(s): %s
MSG_SBM_UNKNOWN_SUBCOMMAND=subcomando desconocido: %s (usá install, update o status)
MSG_SBM_UNKNOWN_FLAG=flag desconocido: %s
MSG_SBM_FLAG_NEEDS_VALUE=%s necesita un valor.
MSG_SBM_USAGE=Uso: sbm install [--lang en|es] [--vault PATH] [--yes] [--force]\n       sbm update  [--lang en|es] [--no-pull] [--take-new]\n       sbm status
MSG_SBM_ALREADY_INSTALLED=el método ya está instalado en este CLAUDE_HOME. Usá ./sbm update en cambio.
MSG_SBM_NOT_INSTALLED=el método todavía no está instalado en este CLAUDE_HOME. Corré primero ./sbm install [--vault <path>] (esto también adopta de forma segura un setup ~/.claude hecho a mano que ya exista).
MSG_SBM_REPO_DIRTY=el repo configurado (%s) tiene cambios sin commitear — commiteálos o guardalos con stash, o volvé a correr con --no-pull.
MSG_SBM_REPO_NOT_MAIN=el repo configurado está en el branch '%s', no en 'main' — cambiá a main, o volvé a correr con --no-pull.
MSG_SBM_PULL_FAILED=git pull --ff-only falló en el repo configurado — resolvelo a mano, o volvé a correr con --no-pull.
MSG_SBM_APPLY_FAILED=el apply falló — mirá el error de arriba. No se escribió nada más.
MSG_SBM_METHOD_HEADER=▸ Método → %s
MSG_SBM_VAULT_HEADER=▸ Vault  → %s
MSG_SBM_PROMPT_LANG=Idioma [en]:
MSG_SBM_PROMPT_VAULT=Ruta del vault [~/second-brain]:
MSG_SBM_VAULT_NOT_A_VAULT_PROMPT=%s existe, no está vacío, y no parece un vault de segundo cerebro (no tiene carpeta method/ ni projects/) — ¿lo adoptás igual? [y/N]:
MSG_SBM_VAULT_NOT_A_VAULT=%s existe, no está vacío, y no parece un vault de segundo cerebro (no tiene carpeta method/ ni projects/) — se aborta, no se escribió nada. Volvé a correr con --force para adoptarlo igual, o elegí una ruta --vault distinta o vacía.
MSG_SBM_VAULT_ROOT_REFUSED=--vault resuelve a '/', la raíz del filesystem — eso nunca es un vault válido. Elegí un directorio real.
MSG_SBM_VAULT_TILDE_USER_UNSUPPORTED=--vault '%s' usa la forma "~usuario", que no está soportada — usá una ruta absoluta, o "~/..." para tu propio home.
MSG_SBM_SUMMARY_COUNTS=▸ added=%s updated=%s conflict=%s taken=%s deleted=%s orphaned=%s
MSG_SBM_CONFLICT_LIST_HDR=▸ Revisá estos a mano (el archivo viejo quedó intacto):
MSG_SBM_CONFLICT_LINE=   %s  %s -> %s
MSG_SBM_REMOVED_LIST_HDR=▸ Ya no forman parte del método:
MSG_SBM_REMOVED_LINE=   %s  %s
MSG_SBM_INSTALL_DONE=✓ Método instalado. El vault vive en %s
MSG_SBM_NEXT_STEPS=\nCÓMO EMPEZAR\n  1. (opcional) Abrí %s en Obsidian → "Open folder as vault".\n  2. Mantené el anchor de cada repo fuera del git de tus proyectos (gitignore global):\n       git config --global core.excludesFile ~/.gitignore_global\n       printf 'CLAUDE.local.md\\n.claude/settings.local.json\\n' >> ~/.gitignore_global\n  3. Entrá a cualquier proyecto y arrancá:\n       cd <tu-repo> && claude\n       /new-project <nombre>       # registra el proyecto en el vault\n       /start                    # abre la sesión\n  4. Trabajá el ciclo: plan -> tarea -> /close  (y /learn cuando aprendas algo).\n  5. Chequeá el estado cuando quieras con ./sbm status, y actualizá después con ./sbm update.
MSG_SBM_UPDATE_VERSION_LINE=▸ Método %s -> %s
MSG_SBM_UPDATE_DONE=✓ Actualización completa.
MSG_SBM_STATUS_HEADER=▸ Second Brain Method — status
MSG_SBM_STATUS_VERSION_LINE=   instalada version=%s lang=%s vault=%s
MSG_SBM_STATUS_VERSION_MISMATCH=   ⚠ la versión instalada (%s) difiere de la VERSION de este repo (%s) — corré ./sbm update.
MSG_SBM_STATUS_NEW_FILES_HDR=   archivos .new pendientes de revisión:
MSG_SBM_STATUS_EDITED_FILES_HDR=   editados desde el último apply (sin match en el manifest):
MSG_SBM_STATUS_CLEAN=   ok — sin archivos .new, nada editado desde el último apply.
</content>
